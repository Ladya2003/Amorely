PORT=
JWT_SECRET=
# URL фронта. Можно несколько через запятую — CORS берёт origin каждого.
# Прод (кастомный домен):
CLIENT_URL=https://amorely.love,https://ladya2003.github.io
APP_BASE_PATH=
# Старый project Pages с путём (если ещё нужен): CLIENT_URL=https://ladya2003.github.io/Amorely

MONGODB_URI=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Web Push (PWA): npm run generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@amorely.app
# Секрет для внешнего cron (например Render). Заголовок x-cron-secret или ?secret=
CRON_SECRET=
# Тестовые CLI-скрипты (reset:pet-test, set:currency). По умолчанию выключено.
# ENABLE_TEST_SCRIPTS=true
