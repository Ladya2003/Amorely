# Локальная разработка (опционально)
# PORT=3005
# PUBLIC_URL=   — по умолчанию basename определяется автоматически в App.tsx

# URL бэкенда на Render (в GitHub Actions — секрет REACT_APP_API_URL)
REACT_APP_API_URL=https://your-service.onrender.com

# Google Sign-In (same Web client ID as server GOOGLE_CLIENT_ID)
# Local: set in client/.env (gitignored)
# Prod build (GitHub Actions): repo Settings → Secrets → REACT_APP_GOOGLE_CLIENT_ID
# In Google Cloud → Credentials → your OAuth Web client, add Authorized JavaScript origins:
#   http://localhost        (required by Google for local GIS — without port)
#   http://localhost:3005   (local CRA; this repo uses PORT=3005)
#   https://amorely.love    (prod)
REACT_APP_GOOGLE_CLIENT_ID=
